{
  "name": "nequi-tasks",
  "version": "0.1.1",
  "author": "Technical assessment candidate",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:network": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "lint": "ng lint",
    "typecheck": "tsc --project tsconfig.app.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "tsx tools/task-list.benchmark.ts",
    "firebase:remote-config:enable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/publish-task-search-flag.ps1 -State enabled",
    "firebase:remote-config:disable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/publish-task-search-flag.ps1 -State disabled",
    "firebase:remote-config:verify": "firebase remoteconfig:get",
    "cordova:prepare": "npm run build && cordova prepare",
    "android:requirements": "cordova requirements android",
    "android:devices": "adb devices -l",
    "android:build": "npm run build && cordova build android",
    "android:signing:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-android-release-signing.ps1",
    "android:build:release": "npm run build && cordova build android --release -- --packageType=apk",
    "android:verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-android-release.ps1",
    "android:release": "npm run android:signing:setup && npm run android:build:release && npm run android:verify:release",
    "android:run:device": "npm run build && cordova run android --device",
    "android:run:emulator": "npm run build && cordova run android --emulator",
    "ios:prepare": "npm run build && cordova prepare ios"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.26",
    "@angular/common": "20.3.26",
    "@angular/compiler": "20.3.26",
    "@angular/core": "20.3.26",
    "@angular/forms": "20.3.26",
    "@angular/platform-browser": "20.3.26",
    "@angular/platform-browser-dynamic": "20.3.26",
    "@angular/router": "20.3.26",
    "@ionic/angular": "^8.0.0",
    "firebase": "12.16.0",
    "ionicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.32",
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/cli": "20.3.32",
    "@angular/compiler-cli": "20.3.26",
    "@angular/language-service": "20.3.26",
    "@ionic/angular-toolkit": "^12.0.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cordova": "^13.0.0",
    "cordova-android": "^15.0.0",
    "cordova-ios": "^8.1.1",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.6.2",
    "tsx": "4.23.1",
    "typescript": "~5.9.0"
  },
  "description": "Aplicación móvil de gestión de tareas y categorías para la prueba técnica de Nequi.",
  "cordova": {
    "plugins": {},
    "platforms": [
      "android",
      "ios"
    ]
  }
}
