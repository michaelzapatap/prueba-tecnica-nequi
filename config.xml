<?xml version='1.0' encoding='utf-8'?>
<widget id="com.nequitasks.app" version="0.1.2" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Mis tareas</name>
    <description>Aplicación móvil para administrar tareas y categorías.</description>
    <author>Technical assessment candidate</author>
    <content src="index.html" />
    <access origin="https://firebaseinstallations.googleapis.com" />
    <access origin="https://firebaseremoteconfig.googleapis.com" />
    <preference name="ScrollEnabled" value="false" />
    <preference name="BackupWebStorage" value="none" />
    <preference name="SplashScreenBackgroundColor" value="#ffffff" />
    <preference name="SplashScreenDelay" value="1000" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="200" />
    <platform name="android">
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/splash/splash-icon.xml" />
        <preference name="AndroidWindowSplashScreenIconBackgroundColor" value="#da0081" />
        <resource-file src="resources/android/values/colors.xml" target="app/src/main/res/values/task_colors.xml" />
        <icon background="@color/task_launcher_background" density="ldpi" foreground="resources/android/icon/task-foreground.xml" monochrome="resources/android/icon/task-monochrome.xml" src="resources/android/icon/drawable-ldpi-icon.png" />
        <icon background="@color/task_launcher_background" density="mdpi" foreground="resources/android/icon/task-foreground.xml" monochrome="resources/android/icon/task-monochrome.xml" src="resources/android/icon/drawable-mdpi-icon.png" />
        <icon background="@color/task_launcher_background" density="hdpi" foreground="resources/android/icon/task-foreground.xml" monochrome="resources/android/icon/task-monochrome.xml" src="resources/android/icon/drawable-hdpi-icon.png" />
        <icon background="@color/task_launcher_background" density="xhdpi" foreground="resources/android/icon/task-foreground.xml" monochrome="resources/android/icon/task-monochrome.xml" src="resources/android/icon/drawable-xhdpi-icon.png" />
        <icon background="@color/task_launcher_background" density="xxhdpi" foreground="resources/android/icon/task-foreground.xml" monochrome="resources/android/icon/task-monochrome.xml" src="resources/android/icon/drawable-xxhdpi-icon.png" />
        <icon background="@color/task_launcher_background" density="xxxhdpi" foreground="resources/android/icon/task-foreground.xml" monochrome="resources/android/icon/task-monochrome.xml" src="resources/android/icon/drawable-xxxhdpi-icon.png" />
    </platform>
    <platform name="ios">
        <icon height="57" src="resources/ios/icon/icon.png" width="57" />
        <icon height="114" src="resources/ios/icon/icon@2x.png" width="114" />
